[TEMPLATE]
# =============================================================================
# .env.example — TEMPLATE environment. Salin ke `.env` lalu isi nilai asli.
# `.env` TIDAK pernah di-commit (lihat .gitignore). Jangan simpan secret di sini.
#
# ATURAN STRUKTUR (agar paste onboarding tidak merusak .env lagi):
#   1. Satu key per baris, format persis: KEY=value
#      - tanpa tanda kutip di sekitar value, tanpa spasi di sekitar '=',
#      - tanpa spasi tambahan di akhir baris.
#   2. JANGAN tempel isi dashboard/tutorial/code block ke file ini: baris yang
#      bukan KEY=value diabaikan (menimbulkan kebingungan), dan key DUPLIKAT
#      membuat nilai TERAKHIR menang (last-wins) — paste contoh .env.local bisa
#      diam-diam menimpa nilai asli Anda. Satu file = satu kemunculan per key.
#   3. HANYA key di bawah ini yang dibaca aplikasi (grep process.env di kode).
#      Key lain (mis. SUPABASE_URL polos, SUPABASE_JWKS_URL, host/port/database/
#      user dari halaman Connect) TIDAK dibaca — untuk memakainya harus dengan
#      nama persis di bawah ini. SUPABASE_ACCESS_TOKEN adalah pengecualian
#      provisioning CLI (bukan runtime).
#   4. Jangan menaruh secret server-only di key ber-prefix NEXT_PUBLIC_ — itu
#      bocor ke browser.
#   5. Verifikasi cepat setelah mengisi: jumlah key = jumlah key di file ini,
#      tanpa duplikat (`grep -oE '^[A-Z_]+' .env | sort | uniq -d` kosong).
#
# CHECKLIST KEY (wajib diisi, kecuali yang ditandai opsional):
#   NEXT_PUBLIC_APP_URL                     http://localhost:3000 (dev)
#   NEXT_PUBLIC_SUPABASE_URL                http://127.0.0.1:54321 (lokal)
#                                           ATAU https://<project-ref>.supabase.co (hosted, tanpa /)
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY    anon/publishable (format baru sb_publishable_…)
#   SUPABASE_SECRET_KEY                     service role (format baru sb_secret_…, ATAU eyJ… legacy)
#   CERTIFICATE_SIGNING_SECRET              string rahasia >= 32 karakter (penanda PDF)
#   ROBLOX_WEBHOOK_SECRET                   opsional — kosongkan bila Roblox OFF
#   BLOCKCHAIN_ANCHOR_ENABLED               false (jangan true sebelum provider disetujui)
#   BLOCKCHAIN_PROVIDER                     opsional — kosong
#   BLOCKCHAIN_NETWORK                      opsional — kosong
#   AI_FEEDBACK_ENABLED                     false (AI draft feedback OFF default; butuh
#                                           consent per-org juga — ADR-014)
#   AI_PROVIDER                             opsional — mock (tanpa jaringan) | http | kosong
#   AI_PROVIDER_BASE_URL                    opsional — endpoint provider http
#   AI_PROVIDER_API_KEY                     opsional — secret server-only, JANGAN NEXT_PUBLIC_
#   SUPABASE_ACCESS_TOKEN                   opsional — PAT Supabase (sbp_…) HANYA untuk
#                                           provisioning CLI (supabase login --token). TIDAK
#                                           dibaca runtime aplikasi; jangan dipakai di production.
# =============================================================================

# Public (safe untuk browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Lokal: http://127.0.0.1:54321 — Hosted: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dev_only_replace_me

# Server-only — JANGAN pernah pakai prefix NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_dev_only_replace_me
CERTIFICATE_SIGNING_SECRET=dev-only-32-char-minimum-replace-me-001

# Opsional (integrasi nonaktif = kosongkan / false)
ROBLOX_WEBHOOK_SECRET=
BLOCKCHAIN_ANCHOR_ENABLED=false
# Valid: kosong, mock, algorand-mock (ujian pending->final tanpa jaringan), algorand (shell ADR-018).
BLOCKCHAIN_PROVIDER=
BLOCKCHAIN_NETWORK=
# Algorand (rekomendasi ADR-018) — KOSONG sampai provider dipilih manusia +
# kredensial aman; kosong = shell inert (tidak ada transaksi yang dibuat).
BLOCKCHAIN_ALGORAND_RPC_URL=
BLOCKCHAIN_ALGORAND_API_KEY=

# Opsional — AI draft feedback (ADR-014/017). OFF default; semua server-only.
AI_FEEDBACK_ENABLED=false
AI_PROVIDER=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=

# Opsional — PAT Supabase untuk provisioning CLI saja (lihat header)
SUPABASE_ACCESS_TOKEN=