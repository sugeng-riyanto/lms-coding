{
  "name": "autonomous-learning-lms",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "check:env": "node scripts/check-env.mjs",
    "predev": "npm run check:env",
    "prebuild": "npm run check:env",
    "prestart": "npm run check:env",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "e2e": "playwright test",
    "load:catalog": "k6 run tests/load/catalog.js",
    "load:quiz": "k6 run tests/load/quiz.js",
    "load:cert": "k6 run tests/load/cert-verify.js",
    "db:typecheck": "node scripts/db-advisor.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "lowlight": "^3.3.0",
    "next": "16.3.4",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^9.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "xlsx": "0.18.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.13",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.18.2",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.37.0",
    "eslint-config-next": "16.3.4",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "packageManager": "npm@11.5.2"
}
